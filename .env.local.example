# Copy to .env.local and fill in values from Supabase Dashboard → Project Settings → API.
# Use the Project URL and publishable key (sb_publishable_...). A service-role/secret key is never needed in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=
# Set only after real Sawiri content and the official HTTPS domain are approved.
SAWIRI_INDEXING_ENABLED=false
# Server-only inquiry writer. Never add NEXT_PUBLIC_ to this secret.
SUPABASE_SECRET_KEY=
# Cloudflare Turnstile: required for production inquiry submissions.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Upstash Redis REST: durable IP-based inquiry rate limit, five submissions/hour.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
